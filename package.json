{
  "name": "invoiceops-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --stream --filter @invoiceops/backend --filter @invoiceops/frontend dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "pnpm --filter @invoiceops/backend generate",
    "lint": "eslint .",
    "recovery:bootstrap": "pnpm --filter @invoiceops/backend recovery:bootstrap",
    "recovery:local:reset": "pnpm --filter @invoiceops/backend recovery:local:reset",
    "test": "pnpm run test:unit",
    "test:integration": "pnpm --filter @invoiceops/backend test:integration",
    "test:recovery:contracts": "pnpm --filter @invoiceops/backend test:recovery:contracts",
    "test:recovery:http": "pnpm --filter @invoiceops/backend test:recovery:http",
    "test:recovery:postgres": "pnpm --filter @invoiceops/backend test:recovery:postgres",
    "test:recovery:unit": "pnpm --filter @invoiceops/backend test:recovery:unit",
    "test:unit": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.4"
  }
}
