generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  ADMIN
  USER
}

enum ResourceOwnerType {
  USER
  GROUP
}

enum Currency {
  CLP
}

enum InvoiceBusinessStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum InvoiceProcessingStatus {
  NOT_REQUESTED
}

enum ApiTokenScope {
  INVOICES_READ          @map("invoices:read")
  INVOICES_CREATE        @map("invoices:create")
  INVOICES_DELETE_OWN    @map("invoices:delete-own")
  INVOICES_DELETE_OTHERS @map("invoices:delete-others")
}

enum PlatformAdministrativeAuditEventType {
  PLATFORM_ADMINISTRATOR_BOOTSTRAPPED
  PLATFORM_ADMINISTRATOR_TRANSFERRED
  ORGANIZATION_MEMBERSHIP_CREATED
  ORGANIZATION_MEMBERSHIP_ROLE_CHANGED
  ORGANIZATION_MEMBERSHIP_REMOVED
  ORGANIZATION_CREATED
  USER_PROVISIONED
  PASSWORD_CHANGED
  GROUP_MEMBERSHIP_CREATED
  GROUP_MEMBERSHIP_REMOVED
  MEMBERSHIP_PERMISSIONS_CHANGED
  USER_DEACTIVATED
  USER_REACTIVATED
  USER_UPDATED
  PASSWORD_RESET
  ORGANIZATION_UPDATED
}

model User {
  id                                 String                             @id @default(uuid())
  name                               String
  rut                                String                             @unique
  email                              String?                            @unique
  username                           String?                            @unique
  passwordHash                       String?
  mustChangePassword                 Boolean                            @default(false)
  temporaryPasswordExpiresAt         DateTime?
  // Set while the user is deactivated; null means enabled.
  disabledAt                         DateTime?
  // Last login or throttled authenticated activity (see auth services).
  lastActiveAt                       DateTime?
  memberships                        OrganizationMembership[]
  groupMemberships                   GroupMembership[]
  sessions                           Session[]
  createdInvoices                    Invoice[]                          @relation("InvoiceCreatedBy")
  deletedInvoices                    Invoice[]                          @relation("InvoiceDeletedBy")
  idempotencyRecords                 InvoiceIdempotencyRecord[]
  apiTokens                          ApiToken[]
  platformAdministrator              PlatformAdministrator?
  platformAdministrativeAuditEvents  PlatformAdministrativeAuditEvent[] @relation("PlatformAdministrativeAuditActor")
  platformAdministrativeAuditTargets PlatformAdministrativeAuditEvent[] @relation("PlatformAdministrativeAuditTarget")

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_name_trgm_idx")
  @@index([rut(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_rut_trgm_idx")
}

model Organization {
  id               String                   @id @default(uuid())
  name             String
  slug             String                   @unique
  description      String?
  enabled          Boolean                  @default(true)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  memberships      OrganizationMembership[]
  groups           Group[]
  invoices         Invoice[]
  businessPolicies BusinessPolicy[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Organization_name_trgm_idx")
}

model OrganizationMembership {
  id                   String            @id @default(uuid())
  userId               String
  organizationId       String
  role                 OrganizationRole
  // Invoice permissions of this user across the whole organization.
  readInvoices         Boolean           @default(false)
  createInvoices       Boolean           @default(false)
  deleteOwnInvoices    Boolean           @default(false)
  deleteOthersInvoices Boolean           @default(false)
  user                 User              @relation(fields: [userId], references: [id])
  organization         Organization      @relation(fields: [organizationId], references: [id])
  groupMemberships     GroupMembership[]

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model Group {
  id                 String                     @id @default(uuid())
  organizationId     String
  name               String
  description        String?
  organization       Organization               @relation(fields: [organizationId], references: [id])
  memberships        GroupMembership[]
  invoices           Invoice[]
  idempotencyRecords InvoiceIdempotencyRecord[]
  apiTokens          ApiToken[]

  @@unique([id, organizationId])
  @@index([organizationId, name])
}

model GroupMembership {
  id                     String                 @id @default(uuid())
  groupId                String
  userId                 String
  organizationId         String
  // Invoice permissions of this user inside the group only.
  readInvoices           Boolean                @default(false)
  createInvoices         Boolean                @default(false)
  deleteOwnInvoices      Boolean                @default(false)
  deleteOthersInvoices   Boolean                @default(false)
  group                  Group                  @relation(fields: [groupId, organizationId], references: [id, organizationId])
  user                   User                   @relation(fields: [userId], references: [id])
  organizationMembership OrganizationMembership @relation(fields: [userId, organizationId], references: [userId, organizationId])

  @@unique([groupId, userId])
  @@index([userId, organizationId])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model Invoice {
  id                 String                     @id @default(uuid())
  businessId         String                     @db.VarChar(80)
  organizationId     String
  groupId            String?
  // COALESCE(groupId, 'organization'), enforced by a CHECK in the migration.
  scopeKey           String
  supplierName       String                     @db.VarChar(200)
  amountPesos        Int
  currency           Currency
  issuedOn           DateTime                   @db.Date
  dueOn              DateTime                   @db.Date
  businessStatus     InvoiceBusinessStatus
  processingStatus   InvoiceProcessingStatus    @default(NOT_REQUESTED)
  createdByUserId    String
  createdAt          DateTime                   @default(now())
  deletedAt          DateTime?
  deletedByUserId    String?
  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  group              Group?                     @relation(fields: [groupId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdByUser      User                       @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  deletedByUser      User?                      @relation("InvoiceDeletedBy", fields: [deletedByUserId], references: [id], onDelete: Restrict)
  idempotencyRecords InvoiceIdempotencyRecord[]

  @@unique([organizationId, businessId])
  @@unique([id, organizationId, scopeKey])
  @@index([organizationId, scopeKey, deletedAt, createdAt(sort: Desc), id(sort: Desc)])
}

model InvoiceIdempotencyRecord {
  id                 String   @id @default(uuid())
  userId             String
  organizationId     String
  groupId            String?
  // COALESCE(groupId, 'organization'), enforced by a CHECK in the migration.
  scopeKey           String
  operation          String
  key                String   @db.VarChar(128)
  fingerprint        String
  fingerprintVersion Int
  invoiceId          String
  responseSnapshot   Json
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  group              Group?   @relation(fields: [groupId, organizationId], references: [id, organizationId], onDelete: Restrict)
  invoice            Invoice  @relation(fields: [invoiceId, organizationId, scopeKey], references: [id, organizationId, scopeKey], onDelete: Restrict)

  @@unique([userId, organizationId, scopeKey, operation, key])
  @@index([invoiceId])
}

model ApiToken {
  id             String          @id @default(uuid())
  userId         String
  name           String
  organizationId String
  groupId        String?
  tokenHash      String          @unique
  scopes         ApiTokenScope[]
  createdAt      DateTime        @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  group          Group?          @relation(fields: [groupId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([userId, organizationId, groupId])
}

model BusinessPolicy {
  id                    String            @id @default(uuid())
  organizationId        String
  ownerType             ResourceOwnerType
  ownerId               String
  version               String
  manualReviewThreshold Decimal
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  organization          Organization      @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, ownerType, ownerId, version])
  @@index([organizationId, ownerType, ownerId])
}

model PlatformAdministrator {
  id        Int      @id @default(1)
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformAdministrativeAuditEvent {
  id                   String                               @id @default(uuid())
  type                 PlatformAdministrativeAuditEventType
  actorUserId          String
  targetUserId         String?
  organizationId       String?
  groupId              String?
  previousRole         OrganizationRole?
  role                 OrganizationRole?
  // The new invoice flags of a membership event (created or permissions
  // changed); null for events that carry no flags.
  readInvoices         Boolean?
  createInvoices       Boolean?
  deleteOwnInvoices    Boolean?
  deleteOthersInvoices Boolean?
  // True when the actor changed their own membership (self-grant is allowed
  // but always visible in the audit trail).
  actorIsTarget        Boolean                              @default(false)
  createdAt            DateTime                             @default(now())
  actor                User                                 @relation("PlatformAdministrativeAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  target               User?                                @relation("PlatformAdministrativeAuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt, id])
  @@index([targetUserId, createdAt, id])
}
