generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  ADMIN
  STUDENT
}

model User {
  id           String                   @id @default(uuid())
  name         String
  rut          String                   @unique
  email        String?
  username     String?
  passwordHash String?
  memberships  OrganizationMembership[]
  groupMemberships GroupMembership[]
  sessions     Session[]
}

model Organization {
  id              String                       @id @default(uuid())
  name            String
  slug            String                       @unique
  description     String?
  enabled         Boolean                      @default(true)
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  memberships     OrganizationMembership[]
  authorizedUsers AuthorizedUserOrganization[]
  groups          Group[]
}

model OrganizationMembership {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  role           OrganizationRole
  user           User             @relation(fields: [userId], references: [id])
  organization   Organization     @relation(fields: [organizationId], references: [id])
  groupMemberships GroupMembership[]

  @@unique([userId, organizationId])
}

model Group {
  id             String            @id @default(uuid())
  organizationId String
  name           String
  description    String?
  organization   Organization      @relation(fields: [organizationId], references: [id])
  memberships    GroupMembership[]

  @@unique([id, organizationId])
  @@index([organizationId, name])
}

model GroupMembership {
  id             String                 @id @default(uuid())
  groupId        String
  userId         String
  organizationId String
  group          Group                  @relation(fields: [groupId, organizationId], references: [id, organizationId])
  user           User                   @relation(fields: [userId], references: [id])
  organizationMembership OrganizationMembership @relation(fields: [userId, organizationId], references: [userId, organizationId])

  @@unique([groupId, userId])
  @@index([userId, organizationId])
}

model AuthorizedUserOrganization {
  id             String       @id @default(uuid())
  rut            String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([rut, organizationId])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}
