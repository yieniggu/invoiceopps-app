generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  ADMIN
  STUDENT
}

enum ResourceOwnerType {
  USER
  GROUP
}

enum InvoiceStatus {
  PENDING
  AUTO_PROCESSED
  MANUAL_REVIEW
  CANCELLED
}

enum PlatformAdministrativeAuditEventType {
  PLATFORM_ADMINISTRATOR_BOOTSTRAPPED
  PLATFORM_ADMINISTRATOR_TRANSFERRED
  ORGANIZATION_MEMBERSHIP_CREATED
  ORGANIZATION_MEMBERSHIP_ROLE_CHANGED
  ORGANIZATION_MEMBERSHIP_REMOVED
}

model User {
  id           String                   @id @default(uuid())
  name         String
  rut          String                   @unique
  email        String?
  username     String?
  passwordHash String?
  memberships  OrganizationMembership[]
  groupMemberships GroupMembership[]
  sessions     Session[]
  createdResources ResourceReference[] @relation("ResourceCreatedBy")
  createdInvoices Invoice[] @relation("InvoiceCreatedBy")
  decisionEvents DecisionEvent[]
  platformAdministrator PlatformAdministrator?
  platformAdministrativeAuditEvents PlatformAdministrativeAuditEvent[] @relation("PlatformAdministrativeAuditActor")
  platformAdministrativeAuditTargets PlatformAdministrativeAuditEvent[] @relation("PlatformAdministrativeAuditTarget")
}

model Organization {
  id              String                       @id @default(uuid())
  name            String
  slug            String                       @unique
  description     String?
  enabled         Boolean                      @default(true)
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  memberships     OrganizationMembership[]
  authorizedUsers AuthorizedUserOrganization[]
  groups          Group[]
  resources       ResourceReference[]
  invoices        Invoice[]
  businessPolicies BusinessPolicy[]
}

model OrganizationMembership {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  role           OrganizationRole
  user           User             @relation(fields: [userId], references: [id])
  organization   Organization     @relation(fields: [organizationId], references: [id])
  groupMemberships GroupMembership[]

  @@unique([userId, organizationId])
}

model Group {
  id             String            @id @default(uuid())
  organizationId String
  name           String
  description    String?
  organization   Organization      @relation(fields: [organizationId], references: [id])
  memberships    GroupMembership[]

  @@unique([id, organizationId])
  @@index([organizationId, name])
}

model GroupMembership {
  id             String                 @id @default(uuid())
  groupId        String
  userId         String
  organizationId String
  group          Group                  @relation(fields: [groupId, organizationId], references: [id, organizationId])
  user           User                   @relation(fields: [userId], references: [id])
  organizationMembership OrganizationMembership @relation(fields: [userId, organizationId], references: [userId, organizationId])

  @@unique([groupId, userId])
  @@index([userId, organizationId])
}

model AuthorizedUserOrganization {
  id             String       @id @default(uuid())
  rut            String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([rut, organizationId])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model ResourceReference {
  id              String            @id @default(uuid())
  organizationId  String
  ownerType       ResourceOwnerType
  ownerId         String
  createdByUserId String
  type            String
  label           String
  organization    Organization      @relation(fields: [organizationId], references: [id])
  createdByUser   User              @relation("ResourceCreatedBy", fields: [createdByUserId], references: [id])

  @@index([organizationId, ownerType, ownerId])
}

model Invoice {
  id                          String            @id @default(uuid())
  invoiceId                   String
  organizationId              String
  ownerType                   ResourceOwnerType
  ownerId                     String
  createdByUserId             String
  vendorName                  String
  invoiceAmountCents          Int
  hasPurchaseOrder            Boolean
  threeWayMatch               Boolean
  status                      InvoiceStatus     @default(PENDING)
  vendorTenureDays            Int
  previousIncidents12m        Int
  bankAccountRecentlyChanged  Boolean
  amountVsVendorMedian        Float
  countryRisk                 String
  policyProbability           Decimal?
  policyProbabilitySource     String?
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt
  organization                Organization      @relation(fields: [organizationId], references: [id])
  createdByUser               User              @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id])
  decisionEvents              DecisionEvent[]

  @@unique([organizationId, invoiceId])
  @@index([organizationId, ownerType, ownerId, createdAt, id])
}

model BusinessPolicy {
  id                    String            @id @default(uuid())
  organizationId        String
  ownerType             ResourceOwnerType
  ownerId               String
  version               String
  manualReviewThreshold Decimal
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  organization          Organization      @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, ownerType, ownerId, version])
  @@index([organizationId, ownerType, ownerId])
}

model DecisionEvent {
  id               String   @id @default(uuid())
  invoiceId        String
  decision         String
  ruleVersion      String
  mode             String
  policyVersion    String?
  manualReviewThreshold Decimal?
  policyProbability Decimal?
  policyProbabilitySource String?
  actorUserId      String
  actorName        String
  actorRut         String
  correlationId    String   @unique
  createdAt        DateTime @default(now())
  invoice          Invoice  @relation(fields: [invoiceId], references: [id])
  actor            User     @relation(fields: [actorUserId], references: [id])

  @@index([invoiceId, createdAt, id])
}

model PlatformAdministrator {
  id        Int      @id @default(1)
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformAdministrativeAuditEvent {
  id             String                               @id @default(uuid())
  type           PlatformAdministrativeAuditEventType
  actorUserId    String
  targetUserId   String?
  organizationId String?
  previousRole   OrganizationRole?
  role           OrganizationRole?
  createdAt      DateTime                             @default(now())
  actor          User                                 @relation("PlatformAdministrativeAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  target         User?                                @relation("PlatformAdministrativeAuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt, id])
  @@index([targetUserId, createdAt, id])
}
