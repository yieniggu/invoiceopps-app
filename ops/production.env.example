# Copy to /opt/invoiceops/invoiceops.env (outside the repository) and chmod 600.
# Both passwords must be URL-safe: generate each with `openssl rand -hex 32`.
POSTGRES_USER=invoiceops
POSTGRES_DB=invoiceops
# Owner of the database; used only by the migrate one-shot.
POSTGRES_PASSWORD=
# Unprivileged role the backend and bootstrap connect as.
POSTGRES_APP_USER=invoiceops_app
POSTGRES_APP_PASSWORD=
PUBLIC_ORIGIN=https://invoiceops.aglai.dev
# Image tag, e.g. the short git commit being deployed.
INVOICEOPS_VERSION=
