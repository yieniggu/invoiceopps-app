# Copy to /opt/invoiceops/invoiceops.env (outside the repository) and chmod 600.
# Both passwords must be URL-safe: generate each with `openssl rand -hex 32`.
POSTGRES_USER=invoiceops
POSTGRES_DB=invoiceops
# Owner of the database; used only by the migrate one-shot.
POSTGRES_PASSWORD=
# Unprivileged role the backend and bootstrap connect as.
POSTGRES_APP_USER=invoiceops_app
POSTGRES_APP_PASSWORD=
PUBLIC_ORIGIN=https://invoiceops.aglai.dev
# Image tag, e.g. the short git commit being deployed.
INVOICEOPS_VERSION=

# --- MLOps (MLOPS-07). Leave all of these empty to keep the app exactly as before ML. ---
# The same file feeds the whole unified stack (invoiceops-stack `include:`s the app, invoiceops-mlflow
# and invoiceops-model-api): one value per secret, generated once (see dev/tickets/MLOPS-07_plan.md).
# Internal URLs (docker network invoiceops_api, no TLS):
MODEL_API_URL=
MLFLOW_GATEWAY_INTERNAL_URL=
# Browser-facing MLflow origin (no path): https://mlflow-invoiceops.aglai.dev
MLFLOW_PUBLIC_URL=
# Secrets, 32-512 chars, hex (openssl rand -hex 32), each one DIFFERENT (the backend refuses
# to start with repeated characters, a repeated word or two identical values; rotation: README):
MODEL_API_SERVICE_TOKEN=
GATEWAY_SERVICE_READ_TOKEN=
INTERNAL_INTROSPECTION_SECRET=
# Used by the gateway project: https://invoiceops.aglai.dev
APP_PUBLIC_URL=
GATEWAY_PUBLIC_ORIGIN=
# MLflow project secrets.
MLFLOW_AUTH_ADMIN_USERNAME=
MLFLOW_AUTH_ADMIN_PASSWORD=
MLFLOW_FLASK_SERVER_SECRET_KEY=
MLFLOW_DB_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Model API only.
OFFICIAL_VALIDATION_SEED=

# Optional overrides (the defaults are correct; leave commented unless you need them).
# Header that carries the real client IP behind the tunnel, for the gateway failed-auth throttle.
# The gateway compose already sets cf-connecting-ip; empty means the TCP peer address.
# GATEWAY_CLIENT_IP_HEADER=cf-connecting-ip
# Address-space limits (RLIMIT_AS, MB) of the Model API check children and inference worker.
# Raise both together with the model-api mem_limit if you expect larger models.
# MODEL_CHECK_MEMORY_MB=1024
# MODEL_WORKER_MEMORY_MB=1024
